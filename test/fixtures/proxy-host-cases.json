{
  "note": "代理 host 清洗的跨语言夹具：Node(src/main/settings.mjs 的 cleanHost) 与 Rust(src-tauri/src/webview_proxy.rs 的 clean_host) 必须给出同一结论。两侧测试都读这个文件，改规则就得两侧一起改。valid=true 表示最终会被放进 http://<host>:<port> 的代理 URL。",
  "port": 8080,
  "cases": [
    { "host": "127.0.0.1", "valid": true, "why": "裸 IPv4" },
    { "host": "localhost", "valid": true, "why": "主机名" },
    { "host": "proxy.local", "valid": true, "why": "内网域名" },
    { "host": "proxy-1.corp.example", "valid": true, "why": "带连字符的域名" },
    { "host": "sub_domain.example", "valid": true, "why": "下划线在内网名称里常见，刻意放行" },
    { "host": "[::1]", "valid": true, "why": "带方括号的 IPv6（URL 里必须这样写）" },
    { "host": "[2001:db8::1]", "valid": true, "why": "带方括号的 IPv6 全写" },
    { "host": "[::ffff:1.2.3.4]", "valid": true, "why": "IPv4-mapped IPv6：两侧都用标准库解析，必须放行" },
    { "host": "  proxy.local  ", "valid": true, "why": "两端空白由清洗裁掉" },

    { "host": "", "valid": false, "why": "空 = 没填" },
    { "host": "   ", "valid": false, "why": "空白 = 没填" },
    { "host": "http://proxy.local", "valid": false, "why": "带协议前缀（URL 由程序拼）" },
    { "host": "https://proxy.local", "valid": false, "why": "带协议前缀" },
    { "host": "socks5://proxy.local", "valid": false, "why": "带协议前缀" },
    { "host": "proxy.local:8080", "valid": false, "why": "host:port 写进 host 字段：端口有独立字段，绝不猜" },
    { "host": "proxy.local/path", "valid": false, "why": "带路径" },
    { "host": "proxy.local?x=1", "valid": false, "why": "带查询串" },
    { "host": "proxy.local#frag", "valid": false, "why": "带片段" },
    { "host": "user@proxy.local", "valid": false, "why": "带 userinfo（凭据只走 auth 字段）" },
    { "host": "user:pass@proxy.local", "valid": false, "why": "凭据内联进 host 一律拒绝" },
    { "host": "::1", "valid": false, "why": "裸 IPv6：多冒号，无法与 host:port 区分" },
    { "host": "2001:db8::1", "valid": false, "why": "裸 IPv6" },
    { "host": "[::1", "valid": false, "why": "方括号不闭合" },
    { "host": "::1]", "valid": false, "why": "方括号不闭合" },
    { "host": "[not-ipv6]", "valid": false, "why": "方括号里不是 IPv6 字符集" },
    { "host": "[1.2.3.4]", "valid": false, "why": "方括号里是 IPv4：字符集合法，但 http://[1.2.3.4]:8080 解析不了，放行会让主窗建不起来" },
    { "host": "[::::]", "valid": false, "why": "字符集合法但结构不是 IPv6：同上，解析失败就等于建窗失败" },
    { "host": "[12345::]", "valid": false, "why": "IPv6 组超过 4 位十六进制" },
    { "host": "[::1::2]", "valid": false, "why": "出现两个 ::：不是合法 IPv6" },
    { "host": "proxy local", "valid": false, "why": "内部空白" },
    { "host": "proxy\tlocal", "valid": false, "why": "内部制表符" },
    { "host": "proxy.local\n", "valid": true, "why": "末尾换行属于两端空白，被 trim 裁掉" },
    { "host": "proxy\n.local", "valid": false, "why": "名字内部夹换行" },
    { "host": "代理.local", "valid": false, "why": "非 ASCII 主机名：不做 IDN 猜测" },
    { "host": "-", "valid": false, "why": "没有任何字母数字" },
    { "host": ".", "valid": false, "why": "单个点不是主机" }
  ]
}
