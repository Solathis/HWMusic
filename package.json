{
  "name": "huawei-music-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "华为音乐第三方桌面客户端（Tauri v2 + React）。显示名见 src/shared/app-name.mjs。",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "build:web": "node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "smoke:build": "node scripts/tauri-smoke.mjs",
    "dist:sidecar": "node scripts/build-sidecar.mjs",
    "dist:win": "node scripts/dist-win.mjs",
    "check:nsis": "node scripts/check-nsis-package.mjs",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.6.0",
    "@applemusic-like-lyrics/lyric": "1.1.0",
    "@applemusic-like-lyrics/react": "0.6.0",
    "@pixi/app": "7.4.3",
    "@pixi/core": "7.4.3",
    "@pixi/display": "7.4.3",
    "@pixi/filter-blur": "7.4.3",
    "@pixi/filter-bulge-pinch": "5.1.1",
    "@pixi/filter-color-matrix": "7.4.3",
    "@pixi/sprite": "7.4.3",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "0.468.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "1.64.0",
    "postject": "^1.0.0-alpha.6",
    "shadcn": "^4.22.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
